{
  "name": "@izumi/companion",
  "private": true,
  "version": "0.2.0",
  "description": "Unofficial izumi companion client for Samsung Tizen TVs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickEatsBread/izumiCompanion.git"
  },
  "type": "module",
  "scripts": {
    "brand": "node scripts/generate-brand-assets.mjs",
    "prebuild": "npm run brand",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "build": "npm run notices && npm run typecheck && node scripts/build-tizen.mjs && node scripts/stage-tizen.mjs",
    "test": "vitest run --exclude izucomp/** --maxWorkers 2",
    "check": "npm run typecheck && npm run test",
    "check:m56": "npm run build && node scripts/check-chromium-m56.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "core-js": "^3.50.0",
    "lucide-preact": "^1.38.0",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-legacy": "^8.2.3",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
